# Copy this file to server/.env for local use (optional — the app runs fine without one, using
# its built-in dev defaults). In production, set these as real environment variables / secrets
# on your hosting platform instead of shipping a .env file — see DEPLOY.md.

# Required in production. Anyone who knows this value could forge a login for any account, so it
# must be a long, random, unguessable string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Most hosting platforms set this for you automatically.
PORT=4000

# Required everywhere, including locally. PostgreSQL connection string (e.g. from Neon, Railway,
# or any Postgres host) — the app refuses to start without it. Get a free one at neon.com.
DATABASE_URL=

# Only needed if your frontend is hosted on a DIFFERENT domain than this API. Leave unset for the
# default, supported setup (this same server/Vercel deployment serves the built frontend too, so
# frontend and API share one origin and browsers never send this through CORS at all). If you do split
# them onto separate domains, set this to that frontend's real URL (comma-separated for more than one)
# — production refuses cross-origin calls from anywhere else once it's set, and refuses ALL cross-origin
# calls (not "open wide") while it's unset. This is intentionally NOT required to start in production.
CORS_ORIGIN=

NODE_ENV=production

# Required for automatic recurring-task generation (vercel.json's daily "crons" entry). Vercel sends this
# exact value back as "Authorization: Bearer <CRON_SECRET>" on every cron-triggered request once it's set
# as a real environment variable here — without it, GET /api/cron/generate-recurring refuses every request
# (fails closed), and recurring series only advance when someone completes the current occurrence, same as
# before this existed. Generate one the same way as JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
