# Copy this file to server/.env for local use (optional — the app runs fine without one, using
# its built-in dev defaults). In production, set these as real environment variables / secrets
# on your hosting platform instead of shipping a .env file — see DEPLOY.md.

# Required in production. Anyone who knows this value could forge a login for any account, so it
# must be a long, random, unguessable string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Most hosting platforms set this for you automatically.
PORT=4000

# Where the SQLite database file lives. Leave unset locally. In production, point this at your
# platform's persistent volume/disk mount so data survives restarts and redeploys.
DB_PATH=

# Restrict which website(s) are allowed to call this API. Leave unset if the frontend is served
# by this same server (the default setup) — same-origin requests don't need this at all.
CORS_ORIGIN=

NODE_ENV=production

# Daily Status Email — powers the "Send Status Update" button on the Dashboard (Leader/Admin/Super
# Admin only). Leave all of these unset to leave the feature disabled; the button then just explains
# that email isn't configured yet, instead of failing.

# SMTP credentials for sending mail. Works with any SMTP provider (Gmail app password, Outlook,
# SendGrid, Amazon SES, your company's mail server, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — the "from" address shown to recipients. Defaults to SMTP_USER if left unset.
SMTP_FROM=

# Who the status email is sent to — a comma-separated list of real email addresses.
# Example: STAKEHOLDER_EMAILS=alice@company.com,bob@company.com
STAKEHOLDER_EMAILS=
